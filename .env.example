# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. ANTHROPIC_API_KEY powers "Write it for me" in the script editor (and AI feedback later)
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Free option for "Write it for me" (openrouter.ai/keys). Used instead of Claude when set.
# Free models: 20 requests/min and 50/day per account (1000/day after buying $10 of credit).
OPENROUTER_API_KEY=
# Optional: comma-separated models to try in order (default: nvidia/nemotron-3.5-super-vl:free, google/gemma-4-31b-it:free, openrouter/free)
OPENROUTER_MODEL=

# Demo mode: sample data in the browser, no Supabase needed.
NEXT_PUBLIC_DEMO_MODE=false

# Admin dashboard (/admin). Server-only: never prefix these with NEXT_PUBLIC_.
# Supabase -> Project Settings -> API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Who can open /admin, comma-separated
ADMIN_EMAILS=
